# Port ultrakanban is served on (through nginx). The agent services expect 4317.
ULTRAKANBAN_PORT=4317

# Token used to check pull requests on GitHub. Create one with: gh auth token
# Needs read access to the repositories whose pull requests you link. Optional: the board's Setup page (/setup) takes
# one too, and logging the agents in to GitHub there gives the board theirs.
GITHUB_TOKEN=

# Seconds between pull request checks
GITHUB_SYNC_INTERVAL=60

# Agents container only (docker compose --profile agents): a token from `claude setup-token`, if you'd rather not log
# the agents in to Claude on the Setup page
CLAUDE_CODE_OAUTH_TOKEN=

# Agents container only: an endpoint that serves the agents a local model or another provider's instead of Claude,
# and its token (see docs/agents.md), e.g. Ollama on the machine: http://host.docker.internal:11434 and ollama
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
